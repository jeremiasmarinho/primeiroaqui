    "hono": "^4.12.33",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.25",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "testcontainers": "^12.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "zod": "^4.4.3"
  }
