# Template das variaveis de PRODUCAO — cadastrar no painel do Coolify
# (Environment Variables do recurso), NAO em arquivo no servidor.
#
# Este arquivo e so referencia: ele nao e lido por nada e nao contem valores.
# O .dockerignore bloqueia todo .env* na imagem, e em NODE_ENV=production o
# servidor nao carrega dotenv — as variaveis vem do ambiente do container.

# Definido pelo Coolify no ambiente de execucao. Ver docs/runbook.md: nunca
# colocar NODE_ENV em arquivo .env — o Vite le e quebra o bundle.
NODE_ENV=production
PORT=3333

# Pooler do Supabase em modo TRANSACTION (porta 6543). Pegar em
# Database > Connect > Connection pooling no painel do Supabase.
# NAO apontar para a conexao direta 5432: com varias requisicoes simultaneas
# o container esgota o limite de conexoes do Supabase.
DATABASE_URL=

# Conexao de sessao (porta 5432). Usada apenas por migrations/generate/studio,
# nunca pelo runtime.
DIRECT_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Marcar como secret/oculta no painel — da acesso total ao banco.
SUPABASE_SERVICE_ROLE=
