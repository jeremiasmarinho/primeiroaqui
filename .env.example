# Supabase (preenchido na Fase 1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Prisma / Postgres (preenchido na Fase 1)
DATABASE_URL=
DIRECT_URL=

# App
# NODE_ENV: NAO definir aqui. O Vite (build de producao) infere seu proprio
# modo a partir do comando (`vite build` = production); um NODE_ENV=development
# neste arquivo eh carregado pelo Vite e forca um bundle de desenvolvimento
# (react-dom em modo dev) mesmo em `npm run build`, quebrando o orcamento de
# bundle silenciosamente. Ver docs/runbook.md.
PORT=3333

# Pagar.me (Core API v5) — fundacao de pagamento, modo SANDBOX (Fase 7).
# Secret key de teste (Basic auth). Sem ela, as rotas de pagamento falham
# na hora do uso com erro claro — o app sobe normalmente sem esta chave.
PAGARME_SECRET_KEY=
# Public key de teste — nao usada pelo servidor (o front tokeniza direto
# com o Pagar.me), so pelo smoke-test opcional deste arquivo. IMPORTANTE:
# a autenticacao de POST /tokens e feita EXCLUSIVAMENTE via query string
# ?appId=pk_..., nunca com header Authorization (a doc do Pagar.me e
# explicita: enviar Authorization nesse endpoint especifico da 401).
PAGARME_PUBLIC_KEY=
# Id do recipient (recebedor) da PLATAFORMA no Pagar.me — recebe o split da
# taxa (5% liquido por default, ver PLATFORM_FEE_PERCENT).
PAGARME_PLATFORM_RECIPIENT_ID=
# Percentual da plataforma no split de cada pedido, LIQUIDO de taxas de
# processamento (essas ficam por conta da loja). Default 5 se omitido.
PLATFORM_FEE_PERCENT=5
# Se 'true', bloqueia pagamento quando a loja nao tiver recipientStatus
# 'active'. Default false (sandbox). PRODUCAO DEVE definir como true.
PAGARME_REQUIRE_ACTIVE_RECIPIENT=false
# Opcional: segredo para validar a assinatura (X-Hub-Signature) do webhook
# do Pagar.me. Sem ele, o endpoint aceita e loga qualquer payload — ver
# limitacao documentada em src/server/routes/payments.ts.
PAGARME_WEBHOOK_SECRET=
